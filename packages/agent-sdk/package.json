{
  "name": "spica-agent-sdk",
  "version": "0.1.0",
  "description": "TypeScript client for AI agents to discover, quote and buy APIs through SPICA's Spending Firewall.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ai-agents",
    "x402",
    "usdc",
    "arc",
    "payments"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-even/PayGate.git",
    "directory": "packages/agent-sdk"
  }
}
