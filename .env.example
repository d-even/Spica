# Copy to .env.local. Never commit real values.
# With nothing set, PayGate runs in demo mode: no keys, no money, in-memory data.

# ---- Mode -------------------------------------------------------------------
# demo: simulated payments. live: testnet payments on connected networks.
PAYGATE_MODE=demo
# The URL this app is reached at. Built-in services are served from here.
PAYGATE_PUBLIC_URL=http://localhost:3000

# ---- AI model: the agent -----------------------------------------------------
# Set ONE of these. Without either, a fixed demo planner runs instead.
# Gemini: aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest (Google's current Flash model).
# GEMINI_MODEL=gemini-flash-latest
# Claude: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Optional. Pick explicitly when both keys are set: gemini or claude.
# AGENT_PROVIDER=gemini

# ---- Wallet sign-in -----------------------------------------------------------
# Signs session cookies. At least 32 characters: openssl rand -hex 32
# Required in live mode. Changing it signs everyone out.
PAYGATE_SESSION_SECRET=
# Encrypts provider API keys in Supabase. 64 hex characters: openssl rand -hex 32
# Changing it makes every stored provider key unreadable, so back it up.
PAYGATE_ENCRYPTION_KEY=

# ---- Supabase: required for live mode ---------------------------------------
SUPABASE_URL=
# Server only. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Arc: USDC through Circle Gateway ---------------------------------------
# The agent's buyer wallet. Use a new, dedicated wallet. EOA only: Gateway does
# not support smart-contract wallets for this flow.
AGENT_PRIVATE_KEY=
# Optional overrides. Defaults come from docs.arc.io and developers.circle.com.
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# ARC_TESTNET_GATEWAY_URL=https://gateway-api-testnet.circle.com

# ---- Hedera: USDC through an x402 facilitator -------------------------------
# Blocky402 is the open facilitator named in Hedera's docs.
HEDERA_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=

# ---- Hedera Consensus Service: optional audit trail -------------------------
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_HCS_TOPIC_ID=

# ---- Circle Agent Marketplace ------------------------------------------------
# Off, so the marketplace holds only what providers list on PayGate.
# PAYGATE_CIRCLE_CATALOG=true
